# Quality control and report outputs
# Quality control and report outputs
# Keep specific report files tracked (e.g. multiqc and pipeline summaries) but
# ignore heavy generated report directories and raw log folders.
*.fastqc.zip
multiqc_data/
logs/

# Ignore generic logs and intermediate pipeline/work directories
.nextflow/
work/
results/

# Generic large binary/tabular outputs (still tracked if explicitly unignored below)
*.bigwig
*.bw
*.bedgraph

# Archives and compressed packages
*.zip
*.tar
*.tar.gz
*.tgz
*.rar
*.7z

# Keep source and config files tracked by default
!*.py
!*.yml
!*.yaml

# Explicitly allow these small, important repository files to be committed
!samplesheet.csv
!samples.txt
!multiqc_report.html
!README.md
!workflow\ commands.sh
!html.zip
!*.html.zip